                "show": true,
                "multiline": true,
                "value": "# Generated by scripts.build_science_components.\n# Edit the shared adapter or catalog instead.\nfrom lfx.custom import Component\nfrom lfx.schema import Data, DataFrame, Message\n\nfrom materials_quality.science.langflow_adapter import (\n    node_inputs,\n    node_outputs,\n    output_artifacts,\n    output_report,\n    output_summary,\n    output_table,\n)\nfrom materials_quality.science.ui_schema import ScienceFormMixin, refresh_config\n\n\nclass ScienceIoTableImport(ScienceFormMixin, Component):\n    display_name = \"材料科学·表格文件导入\"\n    description = \"可追溯的表格文件导入；具体方法与前提见随仓库提供的手册。\"\n    name = \"ScienceIoTableImport\"\n    icon = \"FileSpreadsheet\"\n    ui_contract_version = 2\n    ui_operation_key = \"io.table_import\"\n    inputs = node_inputs(\"io.table_import\", {\"path\": \"\", \"header\": 0})\n    outputs = node_outputs(\"io.table_import\")\n\n    def update_build_config(self, build_config, field_value, field_name=None):\n        return refresh_config(self, \"io.table_import\", build_config, field_value, field_name)\n\n    def build_table(self) -> DataFrame:\n        return output_table(self, \"io.table_import\")\n\n    def build_report(self) -> Data:\n        return output_report(self, \"io.table_import\")\n\n    def build_artifacts(self) -> DataFrame:\n        return output_artifacts(self, \"io.table_import\")\n\n    def build_summary(self) -> Message:\n        return output_summary(self, \"io.table_import\")\n",
